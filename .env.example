# Copy to .env.local and fill in real values. Never commit .env* files.

# --- Supabase (Postgres + Storage + magic-link auth) ---
# Project Settings -> Database -> Connection string. Use the pooled
# ("Transaction" mode, port 6543) URL for DATABASE_URL and the direct
# (port 5432) URL for DIRECT_URL — migrations need the direct connection.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# --- MapTiler (map tiles for the journey map) ---
NEXT_PUBLIC_MAPTILER_API_KEY="xxxx"

# --- App ---
# Used to build absolute links (e.g. magic-link redirect target).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
