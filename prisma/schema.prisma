// Prisma schema for Wandering Pins.
// Semantics follow WANDERING_PINS_BRIEF.md section 5. Do not add fields that
// aren't in the brief without checking section 7 (public/private boundary) first.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of schema.prisma. The CLI (migrate,
  // introspect) reads its URL from prisma.config.ts; the app's PrismaClient
  // gets its own connection string via a driver adapter — see src/lib/prisma.ts.
}

enum PinStatus {
  MINTED
  REGISTERED
}

enum AcquiredVia {
  BOUGHT
  TRADED
  GIFT
  FOUND
  OTHER
}

enum PhotoKind {
  FRONT
  BACK
  OTHER
}

model StickerBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  label     String
  quantity  Int

  pins Pin[]

  @@map("sticker_batches")
}

model Pin {
  id           String    @id @default(cuid())
  slug         String    @unique
  status       PinStatus @default(MINTED)
  batchId      String    @map("batch_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  registeredAt DateTime? @map("registered_at")

  batch    StickerBatch @relation(fields: [batchId], references: [id])
  holdings PinHolding[]

  @@map("pins")
}

// id is the Supabase Auth user's UUID directly (no separate default) — one
// identity shared across both systems, no id-mapping table to keep in sync.
//
// username is nullable — Postgres unique indexes allow multiple NULLs, so
// everyone mid-onboarding can sit at username = null without colliding with
// each other. requireAppUser (src/lib/auth.ts) redirects anyone with a null
// username to /onboarding before letting them reach any protected page — by
// the time a user shows up on any PinHolding, their username is guaranteed
// non-null. firstName/lastName/city are never rendered on any public page
// (brief section 7) — username is the only public identity, in the same
// showNamePublicly-gated slot displayName used to occupy.
model User {
  id               String   @id
  email            String   @unique
  username         String?  @unique
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  city             String?
  createdAt        DateTime @default(now()) @map("created_at")
  showNamePublicly Boolean  @default(true) @map("show_name_publicly")

  holdings PinHolding[]

  @@map("users")
}

// The journey spine: one row per person-per-stint-with-a-pin.
// Every field on this model is PUBLIC. See brief section 7 — do not add
// free-typed or user-uploaded fields here.
//
// "At most one open holding per pin" (released_at IS NULL) is enforced by a
// partial unique index added in migration SQL — Prisma's schema DSL has no
// WHERE clause for @@unique. See prisma/migrations/*_pin_holdings_partial_unique_open
// and *_release_without_recipient (this constraint was briefly dropped to
// support two-sided addressed trades, then restored once those were retired
// in favor of one-sided, unaddressed release — brief section 6.4).
model PinHolding {
  id          String      @id @default(cuid())
  pinId       String      @map("pin_id")
  userId      String      @map("user_id")
  acquiredAt  DateTime    @map("acquired_at")
  acquiredVia AcquiredVia @map("acquired_via")
  placeLabel  String      @map("place_label")
  lat         Float
  lng         Float
  releasedAt  DateTime?   @map("released_at")

  pin  Pin  @relation(fields: [pinId], references: [id])
  user User @relation(fields: [userId], references: [id])

  note   HoldingNote?
  photos HoldingPhoto[]
  title  PinTitle?

  @@index([pinId])
  @@index([userId])
  @@map("pin_holdings")
}

// Private: readable only by the user who owns the parent holding.
// releaseDate/releasePlaceLabel are optional context the giver can add after
// releasing a pin with no specific recipient (brief section 6.4) — when they
// let it go and where, alongside the existing free-typed body for anything
// else. Never shown publicly, same as body.
model HoldingNote {
  id                String    @id @default(cuid())
  holdingId         String    @unique @map("holding_id")
  body              String
  releaseDate       DateTime? @map("release_date")
  releasePlaceLabel String?   @map("release_place_label")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("holding_notes")
}

// Private: readable only by the user who owns the parent holding.
// Never rendered on any public page in v1.
model HoldingPhoto {
  id        String    @id @default(cuid())
  holdingId String    @map("holding_id")
  url       String
  kind      PhotoKind
  createdAt DateTime  @default(now()) @map("created_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@index([holdingId])
  @@map("holding_photos")
}

// Private, because it's free-typed. See brief section 7.
model PinTitle {
  id        String @id @default(cuid())
  holdingId String @unique @map("holding_id")
  title     String

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("pin_titles")
}

// Rate-limiting /p/{slug} by IP (brief section 8) — the compensating
// control for spending a check-digit character on error detection rather
// than on entropy, since the ~1B keyspace is otherwise scrapeable by brute
// force. Fixed 60s windows per IP; not modeled as a relation to anything.
model RateLimitHit {
  id          String   @id @default(cuid())
  ip          String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@unique([ip, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

