// Prisma schema for Wandering Pins.
// Semantics follow WANDERING_PINS_BRIEF.md section 5. Do not add fields that
// aren't in the brief without checking section 7 (public/private boundary) first.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of schema.prisma. The CLI (migrate,
  // introspect) reads its URL from prisma.config.ts; the app's PrismaClient
  // gets its own connection string via a driver adapter — see src/lib/prisma.ts.
}

enum PinStatus {
  MINTED
  REGISTERED
}

enum AcquiredVia {
  BOUGHT
  TRADED
  GIFT
  FOUND
  OTHER
}

enum TradeStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum PhotoKind {
  FRONT
  BACK
  OTHER
}

model StickerBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  label     String
  quantity  Int

  pins Pin[]

  @@map("sticker_batches")
}

model Pin {
  id           String    @id @default(cuid())
  slug         String    @unique
  status       PinStatus @default(MINTED)
  batchId      String    @map("batch_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  registeredAt DateTime? @map("registered_at")

  batch    StickerBatch @relation(fields: [batchId], references: [id])
  holdings PinHolding[]
  trades   Trade[]

  @@map("pins")
}

// id is the Supabase Auth user's UUID directly (no separate default) — one
// identity shared across both systems, no id-mapping table to keep in sync.
model User {
  id               String   @id
  email            String   @unique
  displayName      String   @map("display_name")
  createdAt        DateTime @default(now()) @map("created_at")
  showNamePublicly Boolean  @default(true) @map("show_name_publicly")

  holdings        PinHolding[]
  tradesInitiated Trade[]      @relation("TradeFromUser")
  tradesReceived  Trade[]      @relation("TradeToUser")

  @@map("users")
}

// The journey spine: one row per person-per-stint-with-a-pin.
// Every field on this model is PUBLIC. See brief section 7 — do not add
// free-typed or user-uploaded fields here.
//
// A pin can have more than one open (released_at IS NULL) holding at once —
// claiming a trade and releasing it are independent, one-sided actions (brief
// section 6.4), so there's a window where both the giver's and receiver's
// holdings are open. "Current holder" for display is whichever open holding
// has the latest acquired_at — see /p/[slug]/page.tsx.
model PinHolding {
  id          String      @id @default(cuid())
  pinId       String      @map("pin_id")
  userId      String      @map("user_id")
  acquiredAt  DateTime    @map("acquired_at")
  acquiredVia AcquiredVia @map("acquired_via")
  placeLabel  String      @map("place_label")
  lat         Float
  lng         Float
  releasedAt  DateTime?   @map("released_at")

  pin  Pin  @relation(fields: [pinId], references: [id])
  user User @relation(fields: [userId], references: [id])

  note   HoldingNote?
  photos HoldingPhoto[]
  title  PinTitle?
  trades Trade[]

  @@index([pinId])
  @@index([userId])
  @@map("pin_holdings")
}

// Private: readable only by the user who owns the parent holding.
model HoldingNote {
  id        String   @id @default(cuid())
  holdingId String   @unique @map("holding_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("holding_notes")
}

// Private: readable only by the user who owns the parent holding.
// Never rendered on any public page in v1.
model HoldingPhoto {
  id        String    @id @default(cuid())
  holdingId String    @map("holding_id")
  url       String
  kind      PhotoKind
  createdAt DateTime  @default(now()) @map("created_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@index([holdingId])
  @@map("holding_photos")
}

// Private, because it's free-typed. See brief section 7.
model PinTitle {
  id        String @id @default(cuid())
  holdingId String @unique @map("holding_id")
  title     String

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("pin_titles")
}

// Rate-limiting /p/{slug} by IP (brief section 8) — the compensating
// control for spending a check-digit character on error detection rather
// than on entropy, since the ~1B keyspace is otherwise scrapeable by brute
// force. Fixed 60s windows per IP; not modeled as a relation to anything.
model RateLimitHit {
  id          String   @id @default(cuid())
  ip          String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@unique([ip, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

// Claiming (receiver) and releasing (giver) are independent one-sided
// actions, not a single two-sided confirmation (brief section 6.4) —
// claimedAt and giverReleasedAt are set by separate actions, in either
// order. status becomes CONFIRMED (with resolvedAt) only once both are set;
// DECLINED is only reachable before claimedAt is set (see cancelTrade /
// declineTrade). holdingId pins this trade to the giver's specific holding
// at proposal time, so approveRelease can't accidentally release a
// different, later holding of the same pin — nullable only because it's an
// additive migration onto rows that predate the column.
model Trade {
  id              String      @id @default(cuid())
  pinId           String      @map("pin_id")
  holdingId       String?     @map("holding_id")
  fromUserId      String      @map("from_user_id")
  toUserId        String?     @map("to_user_id")
  toEmail         String?     @map("to_email")
  status          TradeStatus @default(PENDING)
  proposedAt      DateTime    @default(now()) @map("proposed_at")
  claimedAt       DateTime?   @map("claimed_at")
  giverReleasedAt DateTime?   @map("giver_released_at")
  resolvedAt      DateTime?   @map("resolved_at")
  placeLabel      String?     @map("place_label")
  lat             Float?
  lng             Float?

  pin      Pin         @relation(fields: [pinId], references: [id])
  holding  PinHolding? @relation(fields: [holdingId], references: [id])
  fromUser User        @relation("TradeFromUser", fields: [fromUserId], references: [id])
  toUser   User?       @relation("TradeToUser", fields: [toUserId], references: [id])

  @@index([pinId])
  @@index([toEmail])
  @@index([holdingId])
  @@map("trades")
}
