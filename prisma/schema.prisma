// Prisma schema for Wandering Pins.
// Semantics follow WANDERING_PINS_BRIEF.md section 5. Do not add fields that
// aren't in the brief without checking section 7 (public/private boundary) first.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of schema.prisma. The CLI (migrate,
  // introspect) reads its URL from prisma.config.ts; the app's PrismaClient
  // gets its own connection string via a driver adapter — see src/lib/prisma.ts.
}

enum PinStatus {
  MINTED
  REGISTERED
}

enum AcquiredVia {
  BOUGHT
  TRADED
  GIFT
  FOUND
  OTHER
}

enum PhotoKind {
  FRONT
  BACK
  OTHER
}

model StickerBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  label     String
  quantity  Int

  pins Pin[]

  @@map("sticker_batches")
}

model Pin {
  id           String    @id @default(cuid())
  slug         String    @unique
  status       PinStatus @default(MINTED)
  batchId      String    @map("batch_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  registeredAt DateTime? @map("registered_at")

  batch        StickerBatch  @relation(fields: [batchId], references: [id])
  holdings     PinHolding[]
  seriesClaims SeriesClaim[]

  @@map("pins")
}

// id is the Supabase Auth user's UUID directly (no separate default) — one
// identity shared across both systems, no id-mapping table to keep in sync.
//
// username is nullable — Postgres unique indexes allow multiple NULLs, so
// everyone mid-onboarding can sit at username = null without colliding with
// each other. requireAppUser (src/lib/auth.ts) redirects anyone with a null
// username to /onboarding before letting them reach any protected page — by
// the time a user shows up on any PinHolding, their username is guaranteed
// non-null. firstName/lastName/city are never rendered on any public page
// (brief section 7) — username is the only public identity, in the same
// showNamePublicly-gated slot displayName used to occupy.
model User {
  id               String   @id
  email            String   @unique
  username         String?  @unique
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  city             String?
  createdAt        DateTime @default(now()) @map("created_at")
  showNamePublicly Boolean  @default(true) @map("show_name_publicly")

  holdings      PinHolding[]
  seriesCreated Series[]
  seriesItems   SeriesItem[]
  seriesClaims  SeriesClaim[]

  @@map("users")
}

// The journey spine: one row per person-per-stint-with-a-pin.
// Every field on this model is PUBLIC, with one exception: `pending`, which
// gates whether the row is even part of the public journey at all — see
// below. See brief section 7 — do not add free-typed or user-uploaded
// fields here.
//
// "At most one open holding per pin" (released_at IS NULL) is enforced by a
// partial unique index added in migration SQL — Prisma's schema DSL has no
// WHERE clause for @@unique. See prisma/migrations/*_pin_holdings_partial_unique_open
// and *_release_without_recipient (this constraint was briefly dropped to
// support two-sided addressed trades, then restored once those were retired
// in favor of one-sided, unaddressed release — brief section 6.4).
//
// `pending`: a still-held pin can now be claimed tentatively by someone
// else before the current holder releases it (product decision, reverses
// the previous "registration blocked outright" behavior). A pending
// holding has released_at IS NULL like a real open holding, but is not the
// real open holding — it never appears on the public page, and the "one
// open holding per pin" index above only applies to non-pending rows (see
// the migration for the parallel "at most one pending claim per pin"
// index). When the real holder releases, the pending holding auto-promotes
// (pending flips to false) with no other changes to what it already
// recorded.
// `verified`: the holder can confirm their device's actual GPS position was
// near `lat`/`lng` at the moment they checked (see verifyHoldingLocation in
// actions.ts) — an honesty nudge, not proof (not tamper-proof, and city-level
// geocoding can legitimately be tens of km off, hence the generous tolerance
// in src/lib/geo-distance.ts). Public, like every other field here. The raw
// device coordinates are deliberately never stored — only this boolean.
model PinHolding {
  id          String      @id @default(cuid())
  pinId       String      @map("pin_id")
  userId      String      @map("user_id")
  acquiredAt  DateTime    @map("acquired_at")
  acquiredVia AcquiredVia @map("acquired_via")
  placeLabel  String      @map("place_label")
  lat         Float
  lng         Float
  releasedAt  DateTime?   @map("released_at")
  pending     Boolean     @default(false)
  verified    Boolean     @default(false)

  pin  Pin  @relation(fields: [pinId], references: [id])
  user User @relation(fields: [userId], references: [id])

  note     HoldingNote?
  photos   HoldingPhoto[]
  title    PinTitle?
  checkIns HoldingCheckIn[]

  @@index([pinId])
  @@index([userId])
  @@map("pin_holdings")
}

// Private: readable only by the user who owns the parent holding.
// releaseDate/releasePlaceLabel are optional context the giver can add after
// releasing a pin with no specific recipient (brief section 6.4) — when they
// let it go and where, alongside the existing free-typed body for anything
// else. Never shown publicly, same as body.
model HoldingNote {
  id                String    @id @default(cuid())
  holdingId         String    @unique @map("holding_id")
  body              String
  releaseDate       DateTime? @map("release_date")
  releasePlaceLabel String?   @map("release_place_label")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("holding_notes")
}

// Private: readable only by the user who owns the parent holding.
// Never rendered on any public page in v1.
model HoldingPhoto {
  id        String    @id @default(cuid())
  holdingId String    @map("holding_id")
  url       String
  kind      PhotoKind
  createdAt DateTime  @default(now()) @map("created_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@index([holdingId])
  @@map("holding_photos")
}

// Despite the name (kept to avoid an invasive rename), this is the current
// holder's whole public presentation of the pin: a title and now a longer
// description too. Both are free-typed, which the brief's general rule
// (section 7) treats as private by default — but by explicit user
// decision, both are deliberate, narrow public exceptions, exactly like the
// FRONT-kind HoldingPhoto: visible ONLY for the current open holding,
// resolved through a dedicated path in /p/[slug]/page.tsx (never through
// toPublicHolding, which stays the narrow structurally-safe boundary for
// everything else). `title` stays a required column for backward
// compatibility — a description-only row stores `title: ""`, which the
// display layer already treats the same as "no title" ("Untitled Pin").
model PinTitle {
  id          String  @id @default(cuid())
  holdingId   String  @unique @map("holding_id")
  title       String
  description String?

  holding PinHolding @relation(fields: [holdingId], references: [id])

  @@map("pin_titles")
}

// A holder logging that the pin moved to a new place without releasing it —
// "multi-location per-visit logging," a mini-timeline within one holding.
// Public, same discipline as `PinHolding`: only structured place/date fields
// live here, so it can render on the public map/timeline exactly like an
// acquisition leg does. Only ever created against an open, non-pending
// holding — see addCheckIn in checkin-actions.ts.
model HoldingCheckIn {
  id         String   @id @default(cuid())
  holdingId  String   @map("holding_id")
  loggedAt   DateTime @map("logged_at")
  placeLabel String   @map("place_label")
  lat        Float
  lng        Float
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  holding PinHolding @relation(fields: [holdingId], references: [id])

  note   HoldingCheckInNote?
  photos HoldingCheckInPhoto[]

  @@index([holdingId])
  @@map("holding_check_ins")
}

// Private: readable only by the user who owns the parent holding. Optional
// free-typed description of what happened at this location — "what happened
// at that location if you want to." Never rendered on any public page.
model HoldingCheckInNote {
  id        String   @id @default(cuid())
  checkInId String   @unique @map("check_in_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  checkIn HoldingCheckIn @relation(fields: [checkInId], references: [id])

  @@map("holding_check_in_notes")
}

// Private: readable only by the user who owns the parent holding. Never
// rendered on any public page — no moderation filter exists yet (see
// HANDOFF.md's "Photo content moderation" future idea), so these stay
// private for now rather than repeating the front-photo precedent's
// interim risk. Capped at 5 per check-in, enforced in the upload action
// (no DB-level COUNT constraint).
model HoldingCheckInPhoto {
  id        String   @id @default(cuid())
  checkInId String   @map("check_in_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  checkIn HoldingCheckIn @relation(fields: [checkInId], references: [id])

  @@index([checkInId])
  @@map("holding_check_in_photos")
}

// Rate-limiting /p/{slug} by IP (brief section 8) — the compensating
// control for spending a check-digit character on error detection rather
// than on entropy, since the ~1B keyspace is otherwise scrapeable by brute
// force. Fixed 60s windows per IP; not modeled as a relation to anything.
model RateLimitHit {
  id          String   @id @default(cuid())
  ip          String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@unique([ip, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

// --- Series tracking (PinPics/PinAndPop-style set checklists) ---
//
// Deliberately independent of the pins/pin_holdings journey system above:
// most pins someone wants to track in a set (e.g. a blind-box series) will
// never carry a Wandering Pins sticker at all, so this can't require one.
// A SeriesClaim MAY optionally point at one of the claimant's own
// registered pins (`linkedPinId`) purely as a convenience link-through — no
// code path requires it, and nothing here validates the physical pin
// actually matches the design.
//
// This is explicitly NOT the main thrust of the product (user's own
// framing) — the whole point is that it works with *no* admin curation,
// which shapes every rule below:
//
// - Crowd-created: any onboarded user can create a series or add an item to
//   one, the same self-service spirit as everything else in this app.
// - Additive-only editing to limit vandalism without a moderation queue:
//   only the row's own creator may rename/delete it, and only while nothing
//   depends on it yet (a Series with items, or a SeriesItem with claims,
//   can't be deleted — see the actions in src/app/series/actions.ts).
//   Nobody can touch a row someone else created at all.
// - Text-only, no photos, on the shared catalog (Series.name, SeriesItem.
//   label) — a crowd-editable *public* image board is a materially bigger
//   moderation surface than the narrow per-holder photo exception on
//   pin_titles (section 7), since creating a series/item costs nothing (no
//   physical object, no sticker, unlike everything that gates title/
//   description/front photo). A claimant's own photo of their own copy, if
//   ever added, would need to stay private to them, never attached to the
//   shared item.
// - Claims are public (username, subject to show_name_publicly, same as
//   everywhere else) by explicit user decision — that's what makes this
//   useful for finding a trade partner, the same "socially reported, not
//   cryptographically proven" spirit as brief section 1: nothing here
//   verifies a claim is true.
// - `nameKey`/`labelKey` are `name`/`label` normalised (see
//   normalizeSeriesKey in src/lib/series.ts) so near-duplicate typing
//   merges into the same row instead of fragmenting the catalog — creating
//   a series/item is really "find-or-create by normalised key," enforced by
//   the unique constraints below, not just a UI convention.
model Series {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique @map("name_key")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator User         @relation(fields: [createdBy], references: [id])
  items   SeriesItem[]

  @@map("series")
}

// One slot/design within a series (e.g. "4 of 12: Donut"). `position` is
// optional — not every set is numbered.
model SeriesItem {
  id        String   @id @default(cuid())
  seriesId  String   @map("series_id")
  label     String
  labelKey  String   @map("label_key")
  position  Int?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  series  Series        @relation(fields: [seriesId], references: [id])
  creator User          @relation(fields: [createdBy], references: [id])
  claims  SeriesClaim[]

  @@unique([seriesId, labelKey])
  @@map("series_items")
}

// "I have this one" — a lightweight, public checkmark, not a holding: no
// acquisition date/place/photos, just a claim. At most one claim per user
// per item (unclaiming deletes the row rather than tracking history).
model SeriesClaim {
  id           String   @id @default(cuid())
  seriesItemId String   @map("series_item_id")
  userId       String   @map("user_id")
  linkedPinId  String?  @map("linked_pin_id")
  claimedAt    DateTime @default(now()) @map("claimed_at")

  seriesItem SeriesItem @relation(fields: [seriesItemId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  linkedPin  Pin?       @relation(fields: [linkedPinId], references: [id])

  @@unique([seriesItemId, userId])
  @@index([userId])
  @@map("series_claims")
}
